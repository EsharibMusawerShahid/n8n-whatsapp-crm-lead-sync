      "position": [980, 120],
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_ME",
          "name": "HubSpot account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "9f1f6b2a-0000-4000-8000-000000000002",
              "leftValue": "={{ $('Parse Lead Fields').item.json.urgency }}",
              "rightValue": "high",
