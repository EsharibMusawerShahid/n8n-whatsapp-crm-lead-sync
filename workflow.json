{
  "name": "WhatsApp-to-CRM Lead Sync",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"],
        "options": {}
      },
      "id": "b1a1b1a1-0001-4a1a-9a1a-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-120, 0],
      "webhookId": "whatsapp-lead-sync"
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You extract structured lead data from a single inbound WhatsApp message. Reply with ONLY valid JSON, no prose, no markdown fences, matching exactly: {\"name\": string or null, \"intent\": string, \"urgency\": \"low\" | \"medium\" | \"high\"}. \"name\" is the sender's name if they state it, otherwise null. \"intent\" is a short phrase (max 8 words) summarising what they want (e.g. \"pricing question\", \"wants a demo\", \"complaint about order\"). \"urgency\" is \"high\" only for things like a broken/urgent issue, an angry or upset tone, or an explicit time pressure (\"today\", \"ASAP\"); \"medium\" for a normal sales or support question; \"low\" for general chit-chat or a message with no clear ask."
            },
            {
              "role": "user",
              "content": "={{ $json.messages[0].text.body }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0
        }
      },
      "id": "b1a1b1a1-0002-4a1a-9a1a-000000000002",
      "name": "Extract Lead Info (LLM)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [100, 0],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalises the LLM's raw output + the original trigger payload into one clean object.\n// Falls back safely if the LLM didn't return valid JSON, so a bad parse never silently kills the run.\nconst trigger = $('WhatsApp Trigger').item.json;\nconst phone = trigger.messages?.[0]?.from || trigger.contacts?.[0]?.wa_id || null;\nconst rawMessage = trigger.messages?.[0]?.text?.body || '';\n\nlet parsed;\ntry {\n  const raw = $json.message?.content ?? $json.text ?? $json;\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (err) {\n  parsed = { name: null, intent: 'unparsed message - needs manual review', urgency: 'medium' };\n}\n\nreturn [\n  {\n    json: {\n      phone,\n      rawMessage,\n      name: parsed.name || null,\n      intent: parsed.intent || 'unknown',\n      urgency: ['low', 'medium', 'high'].includes(parsed.urgency) ? parsed.urgency : 'medium',\n    },\n  },\n];"
      },
      "id": "b1a1b1a1-0003-4a1a-9a1a-000000000003",
      "name": "Parse Lead Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [ { filters: [ { propertyName: \"phone\", operator: \"EQ\", value: $json.phone } ] } ], properties: [\"phone\", \"firstname\", \"lastname\"] }) }}",
        "options": {}
      },
      "id": "b1a1b1a1-0004-4a1a-9a1a-000000000004",
      "name": "Dedupe - Search CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 0],
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_ME",
          "name": "HubSpot account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "9f1f6b2a-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1a1b1a1-0005-4a1a-9a1a-000000000005",
      "name": "Contact Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 0]
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "update",
        "contactId": "={{ $json.results[0].id }}",
        "additionalFields": {
          "firstname": "={{ $('Parse Lead Fields').item.json.name }}",
          "phone": "={{ $('Parse Lead Fields').item.json.phone }}"
        }
      },
      "id": "b1a1b1a1-0006-4a1a-9a1a-000000000006",
      "name": "Push to CRM - Update",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [980, -120],
      "credentials": {
        "hubspotApi": {
          "id": "REPLACE_ME",
          "name": "HubSpot account"
        }
      }
    },
    {
      "parameters": {
