        "text": "=🚨 High-urgency WhatsApp lead: {{ $('Parse Lead Fields').item.json.name || 'Unknown name' }} ({{ $('Parse Lead Fields').item.json.phone }}) - {{ $('Parse Lead Fields').item.json.intent }}",
        "otherOptions": {}
